{
  "name": "liaoyu-zhice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Liaoning scallop environment assessment and explainable scenario planning",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && node scripts/package-notices.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fetch:data": "node scripts/fetch-marine-data.mjs",
    "verify:data": "node scripts/verify-data.mjs",
    "check": "pnpm verify:data && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "vue": "3.5.22",
    "vue-router": "4.6.3",
    "element-plus": "2.11.5",
    "echarts": "6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.1",
    "vite": "7.1.12",
    "typescript": "5.9.3",
    "vue-tsc": "3.1.2",
    "vitest": "3.2.4",
    "@types/node": "22.18.12",
    "@playwright/test": "1.56.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
